the_ROM_image:
{
	optionaldata { bootbin-version-string-versal-2ve-2vm-vek385-revb-multidomain.txt, id=0x21 }
	optionaldata { bootbin-rollback-counter-versal-2ve-2vm-vek385-revb-multidomain.bin, id=0x22 }
	optionaldata { base-pdi-unique-id-versal-2ve-2vm-vek385-revb-multidomain.txt, id=0x23 }
	optionaldata { xilinx-bootbin-aggregate.manifest.json, id=0x24 }
	image {
	 { type=bootimage, file=base-design.pdi }
	 { type=bootloader, file=plmfw.elf }
	}
	image {
	 id = 0x1c000000, name=apu_ss
	 { type=raw, load=0x1000000, file=cortexa78-linux.dtb }
	 { core=a78-0, cluster=0, exception_level = el-3, trustzone, file=arm-trusted-firmware.elf }
	 { core=a78-0, cluster=0, exception_level = el-1, trustzone, load=0x1800000, file=tee-raw.bin }
	 { core=a78-0, cluster=0, exception_level = el-2, file=u-boot.elf }
	 { core=r52-1, cluster=0, tcmboot, file=irq_shmem_demo.elf }
	}
}
