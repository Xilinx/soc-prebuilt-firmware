/dts-v1/;

/ {
	compatible = "xlnx,zynqmp-zcu216-revA\0xlnx,zynqmp-zcu216\0xlnx,zynqmp\0ZynqMP ZCU216 RevA\0ZynqMP ZCU216 RevA\0ZynqMP ZCU216 RevA\0ZynqMP ZCU216 RevA\0ZynqMP ZCU216 RevA\0ZynqMP ZCU216 RevA\0ZynqMP ZCU216 RevA\0ZynqMP ZCU216 RevA\0ZynqMP ZCU216 RevA";
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "ZynqMP ZCU216 RevA";
	board = "zcu216";
	device_id = "xczu49dr";
	slrcount = <0x01>;
	family = "ZynqMP";
	speed_grade = "2";

	options {

		u-boot {
			compatible = "u-boot,config";
			bootscr-address = <0x00 0x20000000>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		compatible = "cpus,cluster";
		#ranges-address-cells = <0x02>;
		#ranges-size-cells = <0x02>;
		phandle = <0xc7>;

		cpu@0 {
			#cooling-cells = <0x02>;
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			enable-method = "psci";
			operating-points-v2 = <0x82>;
			reg = <0x00>;
			cpu-idle-states = <0x83>;
			next-level-cache = <0x84>;
			clocks = <0x85 0x0a>;
			xlnx,psu-ep = <0x01>;
			xlnx,pss-video-ref-clk-freq = <0x1fc9f08>;
			xlnx,ip-name = "psu_cortexa53";
			xlnx,cpu-1x-clk-freq-hz = <0x00>;
			xlnx,psu-silicon-version = <0x03>;
			cpu-frequency = <0x47865d45>;
			xlnx,cpu-clk-freq-hz = <0x47865d45>;
			xlnx,pss-gt-ref-clk-freq = <0x1fc9f08>;
			xlnx,pss-ref-clk-freq = <0x1fc9f08>;
			bus-handle = <0x01>;
			xlnx,pss-aux-ref-clk-freq = <0x1fc9f08>;
			xlnx,psu-device = "PS8a";
			xlnx,timestamp-clk-freq = <0x5f5dd19>;
			stamp-frequency = <0x5f5dd19>;
			xlnx,pss-alt-ref-clk-freq = <0x1fc9f08>;
			phandle = <0x9a>;
		};

		cpu@1 {
			#cooling-cells = <0x02>;
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			enable-method = "psci";
			reg = <0x01>;
			operating-points-v2 = <0x82>;
			cpu-idle-states = <0x83>;
			next-level-cache = <0x84>;
			xlnx,timestamp-clk-freq = <0x5f5dd19>;
			xlnx,psu-ep = <0x01>;
			xlnx,pss-ref-clk-freq = <0x1fc9f08>;
			stamp-frequency = <0x5f5dd19>;
			xlnx,cpu-1x-clk-freq-hz = <0x00>;
			xlnx,ip-name = "psu_cortexa53";
			xlnx,psu-silicon-version = <0x03>;
			xlnx,psu-device = "PS8a";
			xlnx,cpu-clk-freq-hz = <0x47865d45>;
			bus-handle = <0x01>;
			cpu-frequency = <0x47865d45>;
			phandle = <0x9b>;
		};

		cpu@2 {
			#cooling-cells = <0x02>;
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			enable-method = "psci";
			reg = <0x02>;
			operating-points-v2 = <0x82>;
			cpu-idle-states = <0x83>;
			next-level-cache = <0x84>;
			xlnx,timestamp-clk-freq = <0x5f5dd19>;
			xlnx,psu-ep = <0x01>;
			xlnx,pss-ref-clk-freq = <0x1fc9f08>;
			stamp-frequency = <0x5f5dd19>;
			xlnx,cpu-1x-clk-freq-hz = <0x00>;
			xlnx,ip-name = "psu_cortexa53";
			xlnx,psu-silicon-version = <0x03>;
			xlnx,psu-device = "PS8a";
			xlnx,cpu-clk-freq-hz = <0x47865d45>;
			bus-handle = <0x01>;
			cpu-frequency = <0x47865d45>;
			phandle = <0x9c>;
		};

		cpu@3 {
			#cooling-cells = <0x02>;
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			enable-method = "psci";
			reg = <0x03>;
			operating-points-v2 = <0x82>;
			cpu-idle-states = <0x83>;
			next-level-cache = <0x84>;
			xlnx,timestamp-clk-freq = <0x5f5dd19>;
			xlnx,psu-ep = <0x01>;
			xlnx,pss-ref-clk-freq = <0x1fc9f08>;
			stamp-frequency = <0x5f5dd19>;
			xlnx,cpu-1x-clk-freq-hz = <0x00>;
			xlnx,ip-name = "psu_cortexa53";
			xlnx,psu-silicon-version = <0x03>;
			xlnx,psu-device = "PS8a";
			xlnx,cpu-clk-freq-hz = <0x47865d45>;
			bus-handle = <0x01>;
			cpu-frequency = <0x47865d45>;
			phandle = <0x9d>;
		};

		l2-cache {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			phandle = <0x84>;
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x40000000>;
				local-timer-stop;
				entry-latency-us = <0x12c>;
				exit-latency-us = <0x258>;
				min-residency-us = <0x2710>;
				phandle = <0x83>;
			};
		};
	};

	opp-table-cpu {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x82>;

		opp-1200000000 {
			opp-hz = <0x00 0x47868c00>;
			clock-latency-ns = <0x7a120>;
			opp-microvolt = <0xf4240>;
		};

		opp-600000000 {
			opp-hz = <0x00 0x23c34600>;
			clock-latency-ns = <0x7a120>;
			opp-microvolt = <0xf4240>;
		};

		opp-400000000 {
			opp-hz = <0x00 0x17d78400>;
			clock-latency-ns = <0x7a120>;
			opp-microvolt = <0xf4240>;
		};

		opp-300000000 {
			opp-hz = <0x00 0x11e1a300>;
			clock-latency-ns = <0x7a120>;
			opp-microvolt = <0xf4240>;
		};
	};

	zynqmp-ipi {
		bootph-all;
		compatible = "xlnx,zynqmp-ipi-mailbox";
		interrupt-parent = <0x23>;
		interrupts = <0x00 0x23 0x04>;
		xlnx,ipi-id = <0x00>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0xce>;

		mailbox@ff9905c0 {
			bootph-all;
			compatible = "xlnx,zynqmp-ipi-dest-mailbox";
			reg = <0x00 0xff9905c0 0x00 0x20 0x00 0xff9905e0 0x00 0x20 0x00 0xff990e80 0x00 0x20 0x00 0xff990ea0 0x00 0x20>;
			reg-names = "local_request_region\0local_response_region\0remote_request_region\0remote_response_region";
			#mbox-cells = <0x01>;
			xlnx,ipi-id = <0x04>;
			phandle = <0x9e>;
		};
	};

	dcc {
		compatible = "arm,dcc";
		status = "disabled";
		bootph-all;
		phandle = <0xcf>;
	};

	pmu {
		compatible = "arm,cortex-a53-pmu";
		interrupt-parent = <0x23>;
		interrupts = <0x00 0x8f 0x04 0x00 0x90 0x04 0x00 0x91 0x04 0x00 0x92 0x04>;
		interrupt-affinity = <0x9a 0x9b 0x9c 0x9d>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	firmware {

		zynqmp-firmware {
			compatible = "xlnx,zynqmp-firmware";
			#power-domain-cells = <0x01>;
			method = "smc";
			bootph-all;
			phandle = <0x8e>;

			power-management {
				bootph-all;
				compatible = "xlnx,zynqmp-power";
				interrupt-parent = <0x23>;
				interrupts = <0x00 0x23 0x04>;
				mboxes = <0x9e 0x00 0x9e 0x01>;
				mbox-names = "tx\0rx";
				phandle = <0xd0>;
			};

			soc-nvmem {
				compatible = "xlnx,zynqmp-nvmem-fw";

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <0x01>;
					#size-cells = <0x01>;

					soc-revision@0 {
						reg = <0x00 0x04>;
						phandle = <0xd1>;
					};

					efuse-dna@c {
						reg = <0x0c 0x0c>;
						phandle = <0xd2>;
					};

					efuse-usr0@20 {
						reg = <0x20 0x04>;
						phandle = <0xd3>;
					};

					efuse-usr1@24 {
						reg = <0x24 0x04>;
						phandle = <0xd4>;
					};

					efuse-usr2@28 {
						reg = <0x28 0x04>;
						phandle = <0xd5>;
					};

					efuse-usr3@2c {
						reg = <0x2c 0x04>;
						phandle = <0xd6>;
					};

					efuse-usr4@30 {
						reg = <0x30 0x04>;
						phandle = <0xd7>;
					};

					efuse-usr5@34 {
						reg = <0x34 0x04>;
						phandle = <0xd8>;
					};

					efuse-usr6@38 {
						reg = <0x38 0x04>;
						phandle = <0xd9>;
					};

					efuse-usr7@3c {
						reg = <0x3c 0x04>;
						phandle = <0xda>;
					};

					efuse-miscusr@40 {
						reg = <0x40 0x04>;
						phandle = <0xdb>;
					};

					efuse-chash@50 {
						reg = <0x50 0x04>;
						phandle = <0xdc>;
					};

					efuse-pufmisc@54 {
						reg = <0x54 0x04>;
						phandle = <0xdd>;
					};

					efuse-sec@58 {
						reg = <0x58 0x04>;
						phandle = <0xde>;
					};

					efuse-spkid@5c {
						reg = <0x5c 0x04>;
						phandle = <0xdf>;
					};

					efuse-aeskey@60 {
						reg = <0x60 0x20>;
						phandle = <0xe0>;
					};

					efuse-ppk0hash@a0 {
						reg = <0xa0 0x30>;
						phandle = <0xe1>;
					};

					efuse-ppk1hash@d0 {
						reg = <0xd0 0x30>;
						phandle = <0xe2>;
					};

					efuse-pufuser@100 {
						reg = <0x100 0x7f>;
						phandle = <0xe3>;
					};
				};
			};

			pcap {
				compatible = "xlnx,zynqmp-pcap-fpga";
				phandle = <0xa4>;
			};

			reset-controller {
				compatible = "xlnx,zynqmp-reset";
				#reset-cells = <0x01>;
				status = "okay";
				phandle = <0x03>;
			};

			pinctrl {
				compatible = "xlnx,zynqmp-pinctrl";
				status = "okay";
				phandle = <0x04>;

				i2c0-default {
					phandle = <0xab>;

					mux {
						groups = "i2c0_3_grp";
						function = "i2c0";
					};

					conf {
						groups = "i2c0_3_grp";
						bias-pull-up;
						slew-rate = <0x01>;
						power-source = <0x01>;
					};
				};

				i2c0-gpio-grp {
					phandle = <0xac>;

					mux {
						groups = "gpio0_14_grp\0gpio0_15_grp";
						function = "gpio0";
					};

					conf {
						groups = "gpio0_14_grp\0gpio0_15_grp";
						slew-rate = <0x01>;
						power-source = <0x01>;
					};
				};

				i2c1-default {
					phandle = <0xad>;

					mux {
						groups = "i2c1_4_grp";
						function = "i2c1";
					};

					conf {
						groups = "i2c1_4_grp";
						bias-pull-up;
						slew-rate = <0x01>;
						power-source = <0x01>;
					};
				};

				i2c1-gpio-grp {
					phandle = <0xae>;

					mux {
						groups = "gpio0_16_grp\0gpio0_17_grp";
						function = "gpio0";
					};

					conf {
						groups = "gpio0_16_grp\0gpio0_17_grp";
						slew-rate = <0x01>;
						power-source = <0x01>;
					};
				};
			};

			gpio {
				compatible = "xlnx,zynqmp-gpio-modepin";
				gpio-controller;
				#gpio-cells = <0x02>;
				phandle = <0xb3>;
			};

			clock-controller {
				bootph-all;
				#clock-cells = <0x01>;
				compatible = "xlnx,zynqmp-clk";
				clocks = <0x9f 0xa0 0xa1 0xa2 0xa3>;
				clock-names = "pss_ref_clk\0video_clk\0pss_alt_ref_clk\0aux_ref_clk\0gt_crx_ref_clk";
				phandle = <0x85>;
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x23>;
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
	};

	fpga-region {
		compatible = "fpga-region";
		fpga-mgr = <0xa4>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0xe4>;
	};

	ams {
		compatible = "iio-hwmon";
		io-channels = <0x33 0x00 0x33 0x01 0x33 0x02 0x33 0x03 0x33 0x04 0x33 0x05 0x33 0x06 0x33 0x07 0x33 0x08 0x33 0x09 0x33 0x0a 0x33 0x0b 0x33 0x0c 0x33 0x0d 0x33 0x0e 0x33 0x0f 0x33 0x10 0x33 0x11 0x33 0x12 0x33 0x13 0x33 0x14 0x33 0x15 0x33 0x16 0x33 0x17 0x33 0x18 0x33 0x19 0x33 0x1a 0x33 0x1b 0x33 0x1c 0x33 0x1d>;
	};

	thermal-sensor-apu {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0x00>;
		io-channels = <0x33 0x07>;
		io-channel-names = "sensor-channel";
		phandle = <0xa5>;
	};

	thermal-sensor-rpu {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0x00>;
		io-channels = <0x33 0x08>;
		io-channel-names = "sensor-channel";
		phandle = <0xa7>;
	};

	thermal-sensor-pl {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0x00>;
		io-channels = <0x33 0x14>;
		io-channel-names = "sensor-channel";
		phandle = <0xa8>;
	};

	thermal-zones {

		apu-thermal {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x1388>;
			thermal-sensors = <0xa5>;

			trips {

				passive {
					temperature = <0x16b48>;
					hysteresis = <0xdac>;
					type = "passive";
					phandle = <0xa6>;
				};

				critical {
					temperature = <0x178f4>;
					hysteresis = <0xdac>;
					type = "critical";
					phandle = <0xe5>;
				};
			};

			cooling-maps {

				map {
					trip = <0xa6>;
					cooling-device = <0x9a 0xffffffff 0xffffffff 0x9b 0xffffffff 0xffffffff 0x9c 0xffffffff 0xffffffff 0x9d 0xffffffff 0xffffffff>;
				};
			};
		};

		rpu-thermal {
			polling-delay = <0x2710>;
			thermal-sensors = <0xa7>;

			trips {

				critical {
					temperature = <0x178f4>;
					hysteresis = <0xdac>;
					type = "critical";
				};
			};
		};

		pl-thermal {
			polling-delay = <0x2710>;
			thermal-sensors = <0xa8>;

			trips {

				critical {
					temperature = <0x178f4>;
					hysteresis = <0xdac>;
					type = "critical";
				};
			};
		};
	};

	axi {
		compatible = "simple-bus";
		bootph-all;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		interrupt-parent = <0x23>;
		phandle = <0x01>;

		can@ff060000 {
			compatible = "xlnx,zynq-can-1.0";
			status = "disabled";
			clock-names = "can_clk\0pclk";
			reg = <0x00 0xff060000 0x00 0x1000>;
			interrupts = <0x00 0x17 0x04>;
			interrupt-parent = <0x23>;
			tx-fifo-depth = <0x40>;
			rx-fifo-depth = <0x40>;
			resets = <0x03 0x28>;
			power-domains = <0x8e 0x2f>;
			clocks = <0x85 0x3f 0x85 0x1f>;
			phandle = <0xe6>;
		};

		can@ff070000 {
			compatible = "xlnx,zynq-can-1.0";
			status = "disabled";
			clock-names = "can_clk\0pclk";
			reg = <0x00 0xff070000 0x00 0x1000>;
			interrupts = <0x00 0x18 0x04>;
			interrupt-parent = <0x23>;
			tx-fifo-depth = <0x40>;
			rx-fifo-depth = <0x40>;
			resets = <0x03 0x29>;
			power-domains = <0x8e 0x30>;
			clocks = <0x85 0x40 0x85 0x1f>;
			phandle = <0xe7>;
		};

		cci@fd6e0000 {
			compatible = "arm,cci-400";
			status = "disabled";
			reg = <0x00 0xfd6e0000 0x00 0x9000>;
			ranges = <0x00 0x00 0xfd6e0000 0x10000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			phandle = <0xe8>;

			pmu@9000 {
				compatible = "arm,cci-400-pmu,r1";
				reg = <0x9000 0x5000>;
				interrupt-parent = <0x23>;
				interrupts = <0x00 0x7b 0x04 0x00 0x7b 0x04 0x00 0x7b 0x04 0x00 0x7b 0x04 0x00 0x7b 0x04>;
			};
		};

		debug@fec10000 {
			compatible = "arm,coresight-cpu-debug\0arm,primecell";
			reg = <0x00 0xfec10000 0x00 0x1000>;
			clock-names = "apb_pclk";
			cpu = <0x9a>;
			clocks = <0x85 0x0c>;
			phandle = <0xe9>;
		};

		debug@fed10000 {
			compatible = "arm,coresight-cpu-debug\0arm,primecell";
			reg = <0x00 0xfed10000 0x00 0x1000>;
			clock-names = "apb_pclk";
			cpu = <0x9b>;
			clocks = <0x85 0x0c>;
			phandle = <0xea>;
		};

		debug@fee10000 {
			compatible = "arm,coresight-cpu-debug\0arm,primecell";
			reg = <0x00 0xfee10000 0x00 0x1000>;
			clock-names = "apb_pclk";
			cpu = <0x9c>;
			clocks = <0x85 0x0c>;
			phandle = <0xeb>;
		};

		debug@fef10000 {
			compatible = "arm,coresight-cpu-debug\0arm,primecell";
			reg = <0x00 0xfef10000 0x00 0x1000>;
			clock-names = "apb_pclk";
			cpu = <0x9d>;
			clocks = <0x85 0x0c>;
			phandle = <0xec>;
		};

		dma-controller@fd500000 {
			status = "okay";
			compatible = "xlnx,zynqmp-dma-1.0";
			reg = <0x00 0xfd500000 0x00 0x1000>;
			interrupt-parent = <0x23>;
			interrupts = <0x00 0x7c 0x04>;
			clock-names = "clk_main\0clk_apb";
			#dma-cells = <0x01>;
			xlnx,bus-width = <0x80>;
			power-domains = <0x8e 0x2a>;
			clocks = <0x85 0x13 0x85 0x1f>;
			xlnx,ip-name = "psu_gdma";
			xlnx,dma-mode = <0x00>;
			xlnx,dma-type = <0x00>;
			phandle = <0x51>;
		};

		dma-controller@fd510000 {
			status = "okay";
			compatible = "xlnx,zynqmp-dma-1.0";
			reg = <0x00 0xfd510000 0x00 0x1000>;
			interrupt-parent = <0x23>;
			interrupts = <0x00 0x7d 0x04>;
			clock-names = "clk_main\0clk_apb";
			#dma-cells = <0x01>;
			xlnx,bus-width = <0x80>;
			power-domains = <0x8e 0x2a>;
			clocks = <0x85 0x13 0x85 0x1f>;
			xlnx,ip-name = "psu_gdma";
			xlnx,dma-mode = <0x00>;
			xlnx,dma-type = <0x00>;
			phandle = <0x52>;
		};

		dma-controller@fd520000 {
			status = "okay";
			compatible = "xlnx,zynqmp-dma-1.0";
			reg = <0x00 0xfd520000 0x00 0x1000>;
			interrupt-parent = <0x23>;
			interrupts = <0x00 0x7e 0x04>;
			clock-names = "clk_main\0clk_apb";
			#dma-cells = <0x01>;
