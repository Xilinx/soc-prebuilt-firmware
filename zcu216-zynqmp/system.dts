	domains {

		openamp_a53_0_cluster {
			compatible = "openamp,domain-v1";
			cpus = <0xc7 0x01 0x80000003>;
			phandle = <0x17e>;

			reserved-memory {
				ranges = <0x01>;

				rpu0vdev0vring1 {
					start = <0x9864000>;
					size = <0x4000>;
					no-map = <0x01>;
					phandle = <0x179>;
				};

				rpu0vdev0vring0 {
					start = <0x9860000>;
					size = <0x4000>;
					no-map = <0x01>;
					phandle = <0x178>;
				};

				rpu0vdev0buffer {
					start = <0x9868000>;
					size = <0x40000>;
					no-map = <0x01>;
					phandle = <0x17a>;
				};

				rproc0 {
					start = <0x9800000>;
					size = <0x60000>;
					no-map = <0x01>;
					phandle = <0x176>;
				};

				rpu1vdev0vring1 {
					start = <0x9e64000>;
					size = <0x4000>;
					no-map = <0x01>;
					phandle = <0x17c>;
				};

				rpu1vdev0vring0 {
					start = <0x9e60000>;
					size = <0x4000>;
					no-map = <0x01>;
					phandle = <0x17b>;
				};

				rpu1vdev0buffer {
					start = <0x9e68000>;
					size = <0x40000>;
					no-map = <0x01>;
					phandle = <0x17d>;
				};

				rproc1 {
					start = <0x9e00000>;
					size = <0x60000>;
					no-map = <0x01>;
					phandle = <0x177>;
				};
			};

			domain-to-domain {
				compatible = "openamp,domain-to-domain-v1";

				remoteproc-relation {
					compatible = "openamp,remoteproc-v2";
					remote = <0x174 0x175>;
					elfload;
					elfload0 = <0x6b 0x6c 0x176>;
					elfload1 = <0x6d 0x6e 0x177>;
				};

				rpmsg-relation {
					compatible = "openamp,rpmsg-v1";
					openamp-xlnx-native = <0x00 0x00>;
					remote = <0x174 0x175>;
					carveouts = <0x178 0x179 0x17a 0x17b 0x17c 0x17d>;
					mbox = <0x0b 0x0b>;
				};
			};

			access {
				dev = "psu_r5_0_btcm_global";
				flags = <0x00>;
			};
		};

		openamp_r5_1_cluster {
			compatible = "openamp,domain-v1";
			phandle = <0x175>;

			reserved-memory {
				ranges = <0x01>;

				rpu1vdev0vring1 {
					start = <0x9e64000>;
					size = <0x4000>;
					no-map = <0x01>;
					phandle = <0x180>;
				};

				rpu1vdev0vring0 {
					start = <0x9e60000>;
					size = <0x4000>;
					no-map = <0x01>;
