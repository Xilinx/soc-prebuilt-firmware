	firmware {

		versal-firmware {
			compatible = "xlnx,versal-firmware";
			interrupt-parent = <0x3d>;
			bootph-all;
			method = "smc";
			#power-domain-cells = <0x01>;
			phandle = <0x70>;

			clock-controller {
				bootph-all;
				#clock-cells = <0x01>;
				compatible = "xlnx,versal-clk";
				clocks = <0x95 0x96>;
				clock-names = "ref_clk\0pl_alt_ref_clk";
