		rtc@f12a0000 {
			compatible = "xlnx,zynqmp-rtc";
			status = "okay";
			reg = <0x00 0xf12a0000 0x00 0x100>;
			interrupt-names = "alarm\0sec";
			interrupts = <0x00 0x8e 0x04 0x00 0x8f 0x04>;
			interrupt-parent = <0x3d>;
			calibration = <0x7fff>;
			power-domains = <0x70 0x18224034>;
			xlnx,ip-name = "psv_pmc_rtc";
			phandle = <0x35>;
