/dts-v1/;

/ {
	compatible = "xlnx,zynqmp-zcu104-revA\0xlnx,zynqmp-zcu104\0xlnx,zynqmp\0ZynqMP ZCU104 RevA\0ZynqMP ZCU104 RevA\0ZynqMP ZCU104 RevA\0ZynqMP ZCU104 RevA\0ZynqMP ZCU104 RevA\0ZynqMP ZCU104 RevA\0ZynqMP ZCU104 RevA\0ZynqMP ZCU104 RevA\0ZynqMP ZCU104 RevA";
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "ZynqMP ZCU104 RevA";
	board = "zcu104";
	device_id = "xczu7ev";
	slrcount = <0x01>;
	family = "ZynqMP";
	speed_grade = "2";

	options {

		u-boot {
			compatible = "u-boot,config";
			bootscr-address = <0x00 0x20000000>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		compatible = "cpus,cluster";
		#ranges-address-cells = <0x02>;
		#ranges-size-cells = <0x02>;
		phandle = <0xb0>;

		cpu@0 {
			#cooling-cells = <0x02>;
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			enable-method = "psci";
			operating-points-v2 = <0x74>;
			reg = <0x00>;
			cpu-idle-states = <0x75>;
			next-level-cache = <0x76>;
			clocks = <0x77 0x0a>;
			xlnx,psu-ep = <0x01>;
			xlnx,pss-video-ref-clk-freq = <0x1fc9f08>;
			xlnx,ip-name = "psu_cortexa53";
			xlnx,cpu-1x-clk-freq-hz = <0x00>;
			xlnx,psu-silicon-version = <0x03>;
			cpu-frequency = <0x47868c00>;
			xlnx,cpu-clk-freq-hz = <0x47868c00>;
			xlnx,pss-gt-ref-clk-freq = <0x1fc9f08>;
			xlnx,pss-ref-clk-freq = <0x1fca055>;
			bus-handle = <0x01>;
			xlnx,pss-aux-ref-clk-freq = <0x1fc9f08>;
			xlnx,psu-device = "PS8a";
			xlnx,timestamp-clk-freq = <0x5f5e100>;
			stamp-frequency = <0x5f5e100>;
			xlnx,pss-alt-ref-clk-freq = <0x1fc9f08>;
			phandle = <0x8b>;
		};

		cpu@1 {
			#cooling-cells = <0x02>;
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			enable-method = "psci";
			reg = <0x01>;
			operating-points-v2 = <0x74>;
			cpu-idle-states = <0x75>;
			next-level-cache = <0x76>;
			xlnx,timestamp-clk-freq = <0x5f5e100>;
			xlnx,psu-ep = <0x01>;
			xlnx,pss-ref-clk-freq = <0x1fca055>;
			stamp-frequency = <0x5f5e100>;
			xlnx,cpu-1x-clk-freq-hz = <0x00>;
			xlnx,ip-name = "psu_cortexa53";
			xlnx,psu-silicon-version = <0x03>;
			xlnx,psu-device = "PS8a";
			xlnx,cpu-clk-freq-hz = <0x47868c00>;
			bus-handle = <0x01>;
			cpu-frequency = <0x47868c00>;
			phandle = <0x8c>;
		};

		cpu@2 {
			#cooling-cells = <0x02>;
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			enable-method = "psci";
			reg = <0x02>;
			operating-points-v2 = <0x74>;
			cpu-idle-states = <0x75>;
			next-level-cache = <0x76>;
			xlnx,timestamp-clk-freq = <0x5f5e100>;
			xlnx,psu-ep = <0x01>;
			xlnx,pss-ref-clk-freq = <0x1fca055>;
			stamp-frequency = <0x5f5e100>;
			xlnx,cpu-1x-clk-freq-hz = <0x00>;
			xlnx,ip-name = "psu_cortexa53";
			xlnx,psu-silicon-version = <0x03>;
			xlnx,psu-device = "PS8a";
			xlnx,cpu-clk-freq-hz = <0x47868c00>;
			bus-handle = <0x01>;
			cpu-frequency = <0x47868c00>;
			phandle = <0x8d>;
		};

		cpu@3 {
			#cooling-cells = <0x02>;
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			enable-method = "psci";
			reg = <0x03>;
			operating-points-v2 = <0x74>;
			cpu-idle-states = <0x75>;
			next-level-cache = <0x76>;
			xlnx,timestamp-clk-freq = <0x5f5e100>;
			xlnx,psu-ep = <0x01>;
			xlnx,pss-ref-clk-freq = <0x1fca055>;
			stamp-frequency = <0x5f5e100>;
			xlnx,cpu-1x-clk-freq-hz = <0x00>;
			xlnx,ip-name = "psu_cortexa53";
			xlnx,psu-silicon-version = <0x03>;
			xlnx,psu-device = "PS8a";
			xlnx,cpu-clk-freq-hz = <0x47868c00>;
			bus-handle = <0x01>;
			cpu-frequency = <0x47868c00>;
			phandle = <0x8e>;
		};

		l2-cache {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			phandle = <0x76>;
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x40000000>;
				local-timer-stop;
				entry-latency-us = <0x12c>;
				exit-latency-us = <0x258>;
				min-residency-us = <0x2710>;
				phandle = <0x75>;
			};
		};
	};

	opp-table-cpu {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x74>;

		opp-1200000000 {
			opp-hz = <0x00 0x47868c00>;
			clock-latency-ns = <0x7a120>;
			opp-microvolt = <0xf4240>;
		};

		opp-600000000 {
			opp-hz = <0x00 0x23c34600>;
			clock-latency-ns = <0x7a120>;
			opp-microvolt = <0xf4240>;
		};

		opp-400000000 {
			opp-hz = <0x00 0x17d78400>;
			clock-latency-ns = <0x7a120>;
			opp-microvolt = <0xf4240>;
		};

		opp-300000000 {
			opp-hz = <0x00 0x11e1a300>;
			clock-latency-ns = <0x7a120>;
			opp-microvolt = <0xf4240>;
		};
	};

	zynqmp-ipi {
		bootph-all;
		compatible = "xlnx,zynqmp-ipi-mailbox";
		interrupt-parent = <0x11>;
		interrupts = <0x00 0x23 0x04>;
		xlnx,ipi-id = <0x00>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0xb7>;

		mailbox@ff9905c0 {
			bootph-all;
			compatible = "xlnx,zynqmp-ipi-dest-mailbox";
			reg = <0x00 0xff9905c0 0x00 0x20 0x00 0xff9905e0 0x00 0x20 0x00 0xff990e80 0x00 0x20 0x00 0xff990ea0 0x00 0x20>;
			reg-names = "local_request_region\0local_response_region\0remote_request_region\0remote_response_region";
			#mbox-cells = <0x01>;
			xlnx,ipi-id = <0x04>;
			phandle = <0x8f>;
		};
	};

	dcc {
		compatible = "arm,dcc";
		status = "disabled";
		bootph-all;
		phandle = <0xb8>;
	};

	pmu {
		compatible = "arm,cortex-a53-pmu";
		interrupt-parent = <0x11>;
		interrupts = <0x00 0x8f 0x04 0x00 0x90 0x04 0x00 0x91 0x04 0x00 0x92 0x04>;
		interrupt-affinity = <0x8b 0x8c 0x8d 0x8e>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	firmware {

		zynqmp-firmware {
			compatible = "xlnx,zynqmp-firmware";
			#power-domain-cells = <0x01>;
			method = "smc";
			bootph-all;
			phandle = <0x7f>;

			power-management {
				bootph-all;
				compatible = "xlnx,zynqmp-power";
				interrupt-parent = <0x11>;
				interrupts = <0x00 0x23 0x04>;
				mboxes = <0x8f 0x00 0x8f 0x01>;
				mbox-names = "tx\0rx";
				phandle = <0xb9>;
			};

			soc-nvmem {
				compatible = "xlnx,zynqmp-nvmem-fw";

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <0x01>;
					#size-cells = <0x01>;

					soc-revision@0 {
						reg = <0x00 0x04>;
						phandle = <0xba>;
					};

					efuse-dna@c {
						reg = <0x0c 0x0c>;
						phandle = <0xbb>;
					};

					efuse-usr0@20 {
						reg = <0x20 0x04>;
						phandle = <0xbc>;
					};

					efuse-usr1@24 {
						reg = <0x24 0x04>;
						phandle = <0xbd>;
					};

					efuse-usr2@28 {
						reg = <0x28 0x04>;
						phandle = <0xbe>;
					};

					efuse-usr3@2c {
						reg = <0x2c 0x04>;
						phandle = <0xbf>;
					};

					efuse-usr4@30 {
						reg = <0x30 0x04>;
						phandle = <0xc0>;
					};

					efuse-usr5@34 {
						reg = <0x34 0x04>;
						phandle = <0xc1>;
					};

					efuse-usr6@38 {
						reg = <0x38 0x04>;
						phandle = <0xc2>;
					};

					efuse-usr7@3c {
						reg = <0x3c 0x04>;
						phandle = <0xc3>;
					};

					efuse-miscusr@40 {
						reg = <0x40 0x04>;
						phandle = <0xc4>;
					};

					efuse-chash@50 {
						reg = <0x50 0x04>;
						phandle = <0xc5>;
					};

					efuse-pufmisc@54 {
						reg = <0x54 0x04>;
						phandle = <0xc6>;
					};

					efuse-sec@58 {
						reg = <0x58 0x04>;
						phandle = <0xc7>;
					};

					efuse-spkid@5c {
						reg = <0x5c 0x04>;
						phandle = <0xc8>;
					};

					efuse-aeskey@60 {
						reg = <0x60 0x20>;
						phandle = <0xc9>;
					};

					efuse-ppk0hash@a0 {
						reg = <0xa0 0x30>;
						phandle = <0xca>;
					};

					efuse-ppk1hash@d0 {
						reg = <0xd0 0x30>;
						phandle = <0xcb>;
					};

					efuse-pufuser@100 {
						reg = <0x100 0x7f>;
						phandle = <0xcc>;
					};
				};
			};

			pcap {
				compatible = "xlnx,zynqmp-pcap-fpga";
				phandle = <0x95>;
			};

			reset-controller {
				compatible = "xlnx,zynqmp-reset";
				#reset-cells = <0x01>;
				status = "okay";
				phandle = <0x03>;
			};

			pinctrl {
				compatible = "xlnx,zynqmp-pinctrl";
				status = "okay";
				phandle = <0x04>;

				can1-default {
					phandle = <0x9a>;

					mux {
						function = "can1";
						groups = "can1_6_grp";
					};

					conf {
						groups = "can1_6_grp";
						slew-rate = <0x01>;
						power-source = <0x01>;
						drive-strength = <0x0c>;
					};

					conf-rx {
						pins = "MIO25";
						bias-high-impedance;
					};

					conf-tx {
						pins = "MIO24";
						bias-disable;
					};
				};

				i2c1-default {
					phandle = <0x9e>;

					mux {
						groups = "i2c1_4_grp";
						function = "i2c1";
					};

					conf {
						groups = "i2c1_4_grp";
						bias-pull-up;
						slew-rate = <0x01>;
						power-source = <0x01>;
						drive-strength = <0x0c>;
					};
				};

				i2c1-gpio-grp {
					phandle = <0x9f>;

					mux {
						groups = "gpio0_16_grp\0gpio0_17_grp";
						function = "gpio0";
					};

					conf {
						groups = "gpio0_16_grp\0gpio0_17_grp";
						slew-rate = <0x01>;
						power-source = <0x01>;
						drive-strength = <0x0c>;
					};
				};

				gem3-default {
					phandle = <0x9c>;

					mux {
						function = "ethernet3";
						groups = "ethernet3_0_grp";
					};

					conf {
						groups = "ethernet3_0_grp";
						slew-rate = <0x01>;
						power-source = <0x01>;
						drive-strength = <0x0c>;
					};

					conf-rx {
						pins = "MIO70\0MIO71\0MIO72\0MIO73\0MIO74\0MIO75";
						bias-high-impedance;
						low-power-disable;
					};

					conf-tx {
						pins = "MIO64\0MIO65\0MIO66\0MIO67\0MIO68\0MIO69";
						bias-disable;
						low-power-enable;
					};

					mux-mdio {
						function = "mdio3";
						groups = "mdio3_0_grp";
					};

					conf-mdio {
						groups = "mdio3_0_grp";
						slew-rate = <0x01>;
						power-source = <0x01>;
						bias-disable;
					};
				};

				sdhci1-default {
					phandle = <0xa5>;

					mux {
						groups = "sdio1_0_grp";
						function = "sdio1";
					};

					conf {
						groups = "sdio1_0_grp";
						slew-rate = <0x01>;
						power-source = <0x01>;
						bias-disable;
						drive-strength = <0x0c>;
					};

					mux-cd {
						groups = "sdio1_cd_0_grp";
						function = "sdio1_cd";
					};

					conf-cd {
						groups = "sdio1_cd_0_grp";
						bias-high-impedance;
						bias-pull-up;
						slew-rate = <0x01>;
						power-source = <0x01>;
					};
				};

				uart0-default {
					phandle = <0xa6>;

					mux {
						groups = "uart0_4_grp";
						function = "uart0";
					};

					conf {
						groups = "uart0_4_grp";
						slew-rate = <0x01>;
						power-source = <0x01>;
						drive-strength = <0x0c>;
					};

					conf-rx {
						pins = "MIO18";
						bias-high-impedance;
					};

					conf-tx {
						pins = "MIO19";
						bias-disable;
					};
				};

				uart1-default {
					phandle = <0xa7>;

					mux {
						groups = "uart1_5_grp";
						function = "uart1";
					};

					conf {
						groups = "uart1_5_grp";
						slew-rate = <0x01>;
						power-source = <0x01>;
						drive-strength = <0x0c>;
					};

					conf-rx {
						pins = "MIO21";
						bias-high-impedance;
					};

					conf-tx {
						pins = "MIO20";
						bias-disable;
					};
				};

				usb0-default {
					phandle = <0xa9>;

					mux {
						groups = "usb0_0_grp";
						function = "usb0";
					};

					conf {
						groups = "usb0_0_grp";
						power-source = <0x01>;
					};

					conf-rx {
						pins = "MIO52\0MIO53\0MIO55";
						bias-high-impedance;
						drive-strength = <0x0c>;
						slew-rate = <0x00>;
					};

					conf-tx {
						pins = "MIO54\0MIO56\0MIO57\0MIO58\0MIO59\0MIO60\0MIO61\0MIO62\0MIO63";
						bias-disable;
						drive-strength = <0x04>;
						slew-rate = <0x01>;
					};
				};
			};

			gpio {
				compatible = "xlnx,zynqmp-gpio-modepin";
				gpio-controller;
				#gpio-cells = <0x02>;
				phandle = <0xa8>;
			};

			clock-controller {
				bootph-all;
				#clock-cells = <0x01>;
				compatible = "xlnx,zynqmp-clk";
				clocks = <0x90 0x91 0x92 0x93 0x94>;
				clock-names = "pss_ref_clk\0video_clk\0pss_alt_ref_clk\0aux_ref_clk\0gt_crx_ref_clk";
				phandle = <0x77>;
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x11>;
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
	};

	fpga-region {
		compatible = "fpga-region";
		fpga-mgr = <0x95>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0xcd>;
	};

	ams {
		compatible = "iio-hwmon";
		io-channels = <0x21 0x00 0x21 0x01 0x21 0x02 0x21 0x03 0x21 0x04 0x21 0x05 0x21 0x06 0x21 0x07 0x21 0x08 0x21 0x09 0x21 0x0a 0x21 0x0b 0x21 0x0c 0x21 0x0d 0x21 0x0e 0x21 0x0f 0x21 0x10 0x21 0x11 0x21 0x12 0x21 0x13 0x21 0x14 0x21 0x15 0x21 0x16 0x21 0x17 0x21 0x18 0x21 0x19 0x21 0x1a 0x21 0x1b 0x21 0x1c 0x21 0x1d>;
	};

	thermal-sensor-apu {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0x00>;
		io-channels = <0x21 0x07>;
		io-channel-names = "sensor-channel";
		phandle = <0x96>;
	};

	thermal-sensor-rpu {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0x00>;
		io-channels = <0x21 0x08>;
		io-channel-names = "sensor-channel";
		phandle = <0x98>;
	};

	thermal-sensor-pl {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0x00>;
		io-channels = <0x21 0x14>;
		io-channel-names = "sensor-channel";
		phandle = <0x99>;
	};

	thermal-zones {

		apu-thermal {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x1388>;
			thermal-sensors = <0x96>;

			trips {

				passive {
					temperature = <0x16b48>;
					hysteresis = <0xdac>;
					type = "passive";
					phandle = <0x97>;
				};

				critical {
					temperature = <0x178f4>;
					hysteresis = <0xdac>;
					type = "critical";
					phandle = <0xce>;
				};
			};

			cooling-maps {

				map {
					trip = <0x97>;
					cooling-device = <0x8b 0xffffffff 0xffffffff 0x8c 0xffffffff 0xffffffff 0x8d 0xffffffff 0xffffffff 0x8e 0xffffffff 0xffffffff>;
				};
			};
		};

		rpu-thermal {
			polling-delay = <0x2710>;
			thermal-sensors = <0x98>;

			trips {

				critical {
					temperature = <0x178f4>;
					hysteresis = <0xdac>;
					type = "critical";
				};
			};
		};

		pl-thermal {
			polling-delay = <0x2710>;
			thermal-sensors = <0x99>;

			trips {

				critical {
					temperature = <0x178f4>;
					hysteresis = <0xdac>;
					type = "critical";
				};
			};
		};
	};

	axi {
		compatible = "simple-bus";
		bootph-all;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		interrupt-parent = <0x11>;
		phandle = <0x01>;

		can@ff060000 {
			compatible = "xlnx,zynq-can-1.0";
			status = "disabled";
			clock-names = "can_clk\0pclk";
			reg = <0x00 0xff060000 0x00 0x1000>;
			interrupts = <0x00 0x17 0x04>;
			interrupt-parent = <0x11>;
			tx-fifo-depth = <0x40>;
			rx-fifo-depth = <0x40>;
			resets = <0x03 0x28>;
			power-domains = <0x7f 0x2f>;
			clocks = <0x77 0x3f 0x77 0x1f>;
			phandle = <0xcf>;
		};

		can@ff070000 {
			compatible = "xlnx,zynq-can-1.0";
			status = "okay";
			clock-names = "can_clk\0pclk";
			reg = <0x00 0xff070000 0x00 0x1000>;
			interrupts = <0x00 0x18 0x04>;
			interrupt-parent = <0x11>;
			tx-fifo-depth = <0x40>;
			rx-fifo-depth = <0x40>;
			resets = <0x03 0x29>;
			power-domains = <0x7f 0x30>;
			clocks = <0x77 0x40 0x77 0x1f>;
			xlnx,can-clk-freq-hz = <0x5f5e100>;
			xlnx,ip-name = "psu_can";
			xlnx,can-board-interface = "custom";
			pinctrl-names = "default";
			pinctrl-0 = <0x9a>;
			phandle = <0x27>;
		};

		cci@fd6e0000 {
