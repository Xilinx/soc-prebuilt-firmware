	domains {

		openamp_a53_0_cluster {
			compatible = "openamp,domain-v1";
			cpus = <0xb0 0x01 0x80000003>;
			phandle = <0x157>;

			reserved-memory {
				ranges = <0x01>;

				rpu0vdev0vring1 {
					start = <0x9864000>;
					size = <0x4000>;
					no-map = <0x01>;
					phandle = <0x152>;
				};

				rpu0vdev0vring0 {
					start = <0x9860000>;
					size = <0x4000>;
					no-map = <0x01>;
					phandle = <0x151>;
				};

				rpu0vdev0buffer {
					start = <0x9868000>;
					size = <0x40000>;
					no-map = <0x01>;
					phandle = <0x153>;
				};

				rproc0 {
					start = <0x9800000>;
					size = <0x60000>;
					no-map = <0x01>;
					phandle = <0x14f>;
				};

				rpu1vdev0vring1 {
					start = <0x9e64000>;
					size = <0x4000>;
					no-map = <0x01>;
					phandle = <0x155>;
				};

				rpu1vdev0vring0 {
					start = <0x9e60000>;
					size = <0x4000>;
					no-map = <0x01>;
					phandle = <0x154>;
				};

				rpu1vdev0buffer {
					start = <0x9e68000>;
					size = <0x40000>;
					no-map = <0x01>;
					phandle = <0x156>;
				};

				rproc1 {
					start = <0x9e00000>;
					size = <0x60000>;
					no-map = <0x01>;
					phandle = <0x150>;
				};
			};

			domain-to-domain {
				compatible = "openamp,domain-to-domain-v1";

				remoteproc-relation {
					compatible = "openamp,remoteproc-v2";
					remote = <0x14d 0x14e>;
					elfload;
					elfload0 = <0x5c 0x5d 0x14f>;
					elfload1 = <0x5e 0x5f 0x150>;
				};

				rpmsg-relation {
					compatible = "openamp,rpmsg-v1";
					openamp-xlnx-native = <0x00 0x00>;
					remote = <0x14d 0x14e>;
					carveouts = <0x151 0x152 0x153 0x154 0x155 0x156>;
					mbox = <0x09 0x09>;
				};
			};

			access {
				dev = "psu_r5_0_btcm_global";
				flags = <0x00>;
			};
		};

		openamp_r5_1_cluster {
			compatible = "openamp,domain-v1";
			phandle = <0x14e>;

			reserved-memory {
				ranges = <0x01>;

				rpu1vdev0vring1 {
					start = <0x9e64000>;
					size = <0x4000>;
					no-map = <0x01>;
					phandle = <0x159>;
				};

				rpu1vdev0vring0 {
					start = <0x9e60000>;
					size = <0x4000>;
					no-map = <0x01>;
					phandle = <0x158>;
				};

				rpu1vdev0buffer {
					start = <0x9e68000>;
					size = <0x40000>;
					no-map = <0x01>;
					phandle = <0x15a>;
				};

				rproc1 {
					start = <0x9e00000>;
					size = <0x60000>;
					no-map = <0x01>;
				};
			};

			domain-to-domain {
				compatible = "openamp,domain-to-domain-v1";

				rpmsg-relation {
					compatible = "openamp,rpmsg-v1";
					host = <0x157>;
					mbox = <0x80>;
					carveouts = <0x158 0x159 0x15a>;
				};
			};

			access {
				dev = "psu_r5_1_btcm_global";
				flags = <0x00>;
			};
		};

		openamp_r5_0_cluster {
			compatible = "openamp,domain-v1";
			phandle = <0x14d>;

			reserved-memory {
				ranges = <0x01>;

				rpu0vdev0vring1 {
					start = <0x9864000>;
					size = <0x4000>;
					no-map = <0x01>;
					phandle = <0x15c>;
				};

				rpu0vdev0vring0 {
					start = <0x9860000>;
					size = <0x4000>;
					no-map = <0x01>;
					phandle = <0x15b>;
				};

				rpu0vdev0buffer {
					start = <0x9868000>;
					size = <0x40000>;
					no-map = <0x01>;
					phandle = <0x15d>;
				};

				rproc0 {
					start = <0x9800000>;
					size = <0x60000>;
					no-map = <0x01>;
				};
			};

			domain-to-domain {
				compatible = "openamp,domain-to-domain-v1";

				rpmsg-relation {
					compatible = "openamp,rpmsg-v1";
					host = <0x157>;
					mbox = <0x79>;
					carveouts = <0x15b 0x15c 0x15d>;
				};
			};

			access {
				dev = "psu_r5_0_btcm_global";
				flags = <0x00>;
			};
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		rproc0 {
			no-map;
			reg = <0x00 0x9800000 0x00 0x60000>;
			phandle = <0x15e>;
		};

		rproc1 {
			no-map;
			reg = <0x00 0x9e00000 0x00 0x60000>;
			phandle = <0x15f>;
		};

		vdev0vring0@9860000 {
			no-map;
			reg = <0x00 0x9860000 0x00 0x4000>;
			phandle = <0x160>;
		};

		vdev0vring1@9864000 {
			no-map;
			reg = <0x00 0x9864000 0x00 0x4000>;
			phandle = <0x161>;
		};

		vdev0buffer@9868000 {
			no-map;
			reg = <0x00 0x9868000 0x00 0x40000>;
			compatible = "shared-dma-pool";
			phandle = <0x162>;
		};

		vdev0vring0@9e60000 {
			no-map;
			reg = <0x00 0x9e60000 0x00 0x4000>;
			phandle = <0x165>;
		};

		vdev0vring1@9e64000 {
			no-map;
			reg = <0x00 0x9e64000 0x00 0x4000>;
			phandle = <0x166>;
		};

		vdev0buffer@9e68000 {
			no-map;
			reg = <0x00 0x9e68000 0x00 0x40000>;
			compatible = "shared-dma-pool";
			phandle = <0x167>;
		};
	};

	remoteproc@ffe00000 {
		compatible = "xlnx,zynqmp-r5fss";
		xlnx,cluster-mode = <0x00>;
		xlnx,tcm-mode = <0x00>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges = <0x00 0x00 0x00 0xffe00000 0x00 0x10000 0x00 0x20000 0x00 0xffe20000 0x00 0x10000 0x01 0x00 0x00 0xffe90000 0x00 0x10000 0x01 0x20000 0x00 0xffeb0000 0x00 0x10000>;

		r5f@0 {
			compatible = "xlnx,zynqmp-r5f";
			reg-names = "atcm0\0btcm0";
			reg = <0x00 0x00 0x00 0x10000 0x00 0x20000 0x00 0x10000>;
			memory-region = <0x15e 0x162 0x160 0x161>;
			power-domains = <0x7f 0x07 0x7f 0x0f 0x7f 0x10>;
			mboxes = <0x164 0x00 0x164 0x01>;
			mbox-names = "tx\0rx";
		};

		r5f@1 {
			compatible = "xlnx,zynqmp-r5f";
			reg-names = "atcm0\0btcm0";
			reg = <0x01 0x00 0x00 0x10000 0x01 0x20000 0x00 0x10000>;
			memory-region = <0x15f 0x167 0x165 0x166>;
			power-domains = <0x7f 0x08 0x7f 0x11 0x7f 0x12>;
			mboxes = <0x168 0x00 0x168 0x01>;
			mbox-names = "tx\0rx";
		};
	};

	zynqmp_ipi1 {
		compatible = "xlnx,zynqmp-ipi-mailbox";
		interrupt-parent = <0x11>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;
		interrupts = <0x00 0x1d 0x04>;
		xlnx,ipi-id = <0x07>;
		phandle = <0x163>;

		ipi_mailbox_rpu0 {
			phandle = <0x164>;
			#mbox-cells = <0x01>;
			compatible = "xlnx,zynqmp-ipi-dest-mailbox";
			xlnx,ipi-id = <0x01>;
			reg-names = "local_request_region\0local_response_region\0remote_request_region\0remote_response_region";
			reg = <0xff990600 0x20 0xff990620 0x20 0xff9900c0 0x20 0xff9900e0 0x20>;
		};

		ipi_mailbox_rpu1 {
			phandle = <0x168>;
			#mbox-cells = <0x01>;
			compatible = "xlnx,zynqmp-ipi-dest-mailbox";
			xlnx,ipi-id = <0x02>;
			reg-names = "local_request_region\0local_response_region\0remote_request_region\0remote_response_region";
			reg = <0xff990640 0x20 0xff990660 0x20 0xff9902c0 0x20 0xff9902e0 0x20>;
		};
	};
};
