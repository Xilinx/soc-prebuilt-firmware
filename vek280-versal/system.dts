			phandle = <0x77>;

			aie_aperture@20000000000 {
				xlnx,device-name = <0x00>;
				interrupt-parent = <0x44>;
				interrupts = <0x00 0x94 0x04 0x00 0x95 0x04 0x00 0x96 0x04>;
				#address-cells = <0x02>;
				power-domains = <0x7a 0x18224072>;
				xlnx,node-id = <0x18800000>;
				#size-cells = <0x02>;
				interrupt-names = "interrupt1\0interrupt2\0interrupt3";
				reg = <0x200 0x00 0x01 0x00>;
				xlnx,columns = <0x00 0x26>;
				phandle = <0x14f>;
			};
		};

		gpio@a4810000 {
			xlnx,gpio-board-interface = "Custom";
			compatible = "xlnx,axi-gpio-2.0\0xlnx,xps-gpio-1.00.a";
