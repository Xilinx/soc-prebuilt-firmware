	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		buffer@0 {
			no-map;
			reg = <0x08 0x00 0x00 0x80000000>;
			phandle = <0x08>;
		};

		buffer@1 {
			no-map;
			reg = <0x500 0x00 0x02 0x00>;
			phandle = <0x09>;
		};
	};
